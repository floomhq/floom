[Unit]
Description=Workeros hourly data snapshot and artifact rotation
After=workeros-api.service

[Service]
Type=oneshot
WorkingDirectory=/root/workeros
EnvironmentFile=/root/.config/workeros/api.env
ExecStart=/root/workeros/ops/backup-db.sh
Nice=10
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
StandardOutput=journal
StandardError=journal
