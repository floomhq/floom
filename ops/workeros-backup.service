[Unit]
Description=Workeros daily SQLite snapshot
After=workeros-api.service

[Service]
Type=oneshot
WorkingDirectory=/root/workeros/apps/api
EnvironmentFile=/root/.config/workeros/api.env
ExecStart=/root/workeros/ops/backup-db.sh
Nice=10
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
StandardOutput=journal
StandardError=journal
