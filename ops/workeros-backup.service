[Unit]
Description=Workeros hourly data snapshot and artifact rotation
After=workeros-api.service

[Service]
Type=oneshot
WorkingDirectory=/opt/workeros
EnvironmentFile=/etc/workeros/api.env
ExecStart=/opt/workeros/ops/backup-db.sh
Nice=10
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
StandardOutput=journal
StandardError=journal
