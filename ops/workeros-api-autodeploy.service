[Unit]
Description=Workeros API autodeploy from origin/main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=WORKEROS_ROOT=/root/workeros
Environment=WORKEROS_BRANCH=main
Environment=WORKEROS_AUTODEPLOY_LABEL=workeros-api
Environment=WORKEROS_DEPLOY_CMD=/root/workeros/ops/deploy-api.sh
EnvironmentFile=-/root/.config/workeros/autodeploy.env
ExecStart=/root/workeros/ops/autodeploy-api.sh
StandardOutput=journal
StandardError=journal

