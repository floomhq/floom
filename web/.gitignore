# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. The public build seams (NEXT_PUBLIC_BASE_PATH,
# NEXT_PUBLIC_API_PROXY_BASE) are passed inline by the package.json build/dev
# scripts and set in the Vercel project env — no env file is committed. Secrets
# (FLOOM_API_BASE/SECRET, Supabase keys) come from the Vercel project env too.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Use npm (package-lock.json); avoid pnpm-lock so Vercel picks npm deterministically
pnpm-lock.yaml
