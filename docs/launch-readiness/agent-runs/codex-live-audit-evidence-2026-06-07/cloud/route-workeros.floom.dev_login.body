der-[var(--line)] bg-[var(--paper)] px-3 text-sm outline-none transition-colors placeholder:text-[var(--ink-mute)] focus:border-[var(--ink-soft)]" value=""/></label><button type="submit" class="auth-btn auth-btn-secondary w-full disabled:cursor-not-allowed disabled:opacity-60">Email me a magic link</button></form><p class="mt-6 text-[11.5px] leading-[1.6] text-[var(--ink-mute)] text-center">By signing in you agree to the<!-- --> <a class="underline underline-offset-2 hover:text-[var(--ink)] transition-colors" href="/terms">Terms</a> <!-- -->and<!-- --> <a class="underline underline-offset-2 hover:text-[var(--ink)] transition-colors" href="/privacy">Privacy Policy</a>. We&#x27;ll create your workspace automatically on first sign-in.</p></div><p class="mt-5 text-center text-[12px] text-[var(--ink-mute)]">New here?<!-- --> <a class="text-[var(--ink-soft)] hover:text-[var(--ink)] underline underline-offset-2 transition-colors" href="/">See what Floom does</a></p></div></section><style>
        .auth-btn {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 10px;
          height: 44px;
          border-radius: var(--radius-button);
          font-size: 14px;
