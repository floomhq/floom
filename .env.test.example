# Copy this to .env.test and fill in real credentials.
# .env.test is gitignored — never commit it.
#
# These are the Supabase email/password accounts used by Playwright
# to log in automatically during `npx playwright test --project=setup`.

PLAYWRIGHT_ADMIN_EMAIL=frederico@example.com
PLAYWRIGHT_ADMIN_PASSWORD=your-admin-password

PLAYWRIGHT_MEMBER_EMAIL=vivekbs.10@gmail.com
PLAYWRIGHT_MEMBER_PASSWORD=your-member-password
