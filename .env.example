# OpenAI API key for AI-powered workers
OPENAI_API_KEY=sk-proj-...

# Optional: override paths
FLOOM_DB=./data/floom.db
FLOOM_WORKERS_DIR=./workers
FLOOM_ARTIFACTS_DIR=./data/artifacts

# Composio event triggers: required for POST /composio-events delivery.
# Without it, enabling a composio trigger fails loudly at create time (#908).
# COMPOSIO_WEBHOOK_SIGNING_KEY=whsec_...

# Emily conversation memory (#844): distills durable facts into the private
# `memory` brain pack after each chat. Set 0 to disable; interval in seconds
# throttles writes per conversation (default 1800).
# WORKEROS_MEMORY_ENABLED=1
# WORKEROS_MEMORY_WRITE_INTERVAL=1800
