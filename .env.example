# Supabase — get these from your Supabase project settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WORKEROS_CLOUD_PROJECT_REF=<project-ref>

# Encryption key for stored worker secrets — generate with:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
WORKEROS_CLOUD_SECRETS_ENCRYPTION_KEY=

# Deployment mode: "cloud" for production, omit or set WORKEROS_DEV=1 for local
WORKEROS_DEPLOY=cloud
WORKEROS_DEV=1

# URLs — adjust for local dev or production
WORKEROS_API_BASE=http://localhost:8000
WORKERS_FRONTEND_URL=http://localhost:3000/app
WORKEROS_DASHBOARD_ORIGIN=http://localhost:3000

# OpenAI — required for the worker-author LLM and run engine
OPENAI_API_KEY=sk-...

# Composio — required for third-party tool connections (optional for basic use)
COMPOSIO_API_KEY=

# Resend — required for email notifications (https://resend.com)
# Verify your sending domain in Resend before setting this
RESEND_API_KEY=re_...
NOTIFY_FROM_EMAIL=notifications@workeros.floom.dev

# Git-backed workspace — local dev only.
# On Linux (AX41), defaults to /var/workeros-cloud/workspaces (created on first use).
# On Windows or when the default path isn't writable, set this explicitly.
WORKEROS_GIT_WORKSPACES_DIR=
