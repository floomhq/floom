# OpenAI API key for AI-powered workers and Emily.
OPENAI_API_KEY=sk-proj-...

# E2B sandbox credentials for pure-script worker execution.
E2B_API_KEY=e2b_...

# Optional: use prebuilt E2B templates for faster script-worker startup.
# Set *_DEPS_BAKED=1 only when the template already contains worker deps.
# WORKEROS_E2B_PYTHON_TEMPLATE_ID=
# WORKEROS_E2B_NODE_TEMPLATE_ID=
# WORKEROS_E2B_PYTHON_DEPS_BAKED=0
# WORKEROS_E2B_NODE_DEPS_BAKED=0

# Optional: override paths
FLOOM_DB=./data/floom.db
FLOOM_WORKERS_DIR=./workers
FLOOM_ARTIFACTS_DIR=./data/artifacts

# Composio event triggers: required for POST /composio-events delivery.
# Without it, enabling a composio trigger fails loudly at create time (#908).
# COMPOSIO_WEBHOOK_SIGNING_KEY=whsec_...

# Slack request signing replay window. Security-critical: do not set below 30s.
# The runtime floors lower values to 30s so replay protection cannot be disabled.
# SLACK_SIGNATURE_TOLERANCE_SECONDS=300

# Emily conversation memory (#844): distills durable facts into the private
# `memory` brain pack after each chat. Set 0 to disable; interval in seconds
# throttles writes per conversation (default 1800).
# WORKEROS_MEMORY_ENABLED=1
# WORKEROS_MEMORY_WRITE_INTERVAL=1800

# Cost estimation rate (#793/#795): USD per 1,000,000 tokens, used for the
# per-worker monthly spend cap and approval "cost so far" estimate. Default 5.0.
# WORKEROS_USD_PER_MTOK=5.0

# Worker-call (wrt_) token signing secret (#992). Decoupled from FLOOM_SECRET so
# a multi-tenant host can sign worker-to-worker call tokens without enabling the
# x-floom-secret gate. Falls back to FLOOM_SECRET when unset; OSS needs neither
# unless workers use calls:/call_worker.
# WORKEROS_WORKER_CALL_SECRET=
