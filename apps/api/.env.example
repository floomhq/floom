# Copy this to .env and fill in values
OPENAI_API_KEY=sk-...

# --- Model providers -------------------------------------------------------
# Every model call is selected by a *model id* and routed through litellm.
# OpenAI is the zero-config default; point any role below at another provider's
# id and supply that provider's credentials. Per-role model ids (defaults shown):
#   WORKEROS_WORKER_AGENT_MODEL  tool-calling worker agents      (gpt-5.5)
#   WORKEROS_CHAT_MODEL          Emily, the chat assistant       (gpt-5.4-mini)
#   WORKEROS_CODEGEN_MODEL       worker codegen / draft / repair (gpt-5.5)
#   WORKEROS_SUGGEST_MODEL       worker-edit conflict check      (codegen model)
#
# AWS Bedrock (Claude Sonnet 4.6) example — Anthropic models require submitting
# the one-time Bedrock "use case details" form (per region):
#   WORKEROS_WORKER_AGENT_MODEL=bedrock/us.anthropic.claude-sonnet-4-6
#   WORKEROS_CHAT_MODEL=bedrock/us.anthropic.claude-sonnet-4-6
#   WORKEROS_CODEGEN_MODEL=bedrock/us.anthropic.claude-sonnet-4-6
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   AWS_REGION_NAME=us-west-2
#
# Other litellm providers — set any role's model id to a provider-prefixed id and
# supply that provider's key (tool-call reliability and caching vary by provider):
#   Anthropic (direct):  anthropic/claude-sonnet-4-6     + ANTHROPIC_API_KEY
#   Google Gemini:       gemini/gemini-2.5-pro           + GEMINI_API_KEY
#   Groq:                groq/llama-3.3-70b-versatile    + GROQ_API_KEY

# --- Web search (Emily + workers) ------------------------------------------
# Provider-agnostic web_search function tool (works on every model, incl. Bedrock).
# Free DuckDuckGo by default (no key); set SERPER_API_KEY for Google-quality
# results (serper.dev, ~2,500 free queries/month).
# SERPER_API_KEY=

# Operator secret — gates all API requests via x-floom-secret header.
# Omit entirely to run in unauthenticated local dev mode (no header check).
FLOOM_SECRET=

# E2B sandbox credentials.
# The engine uses E2B_API_KEY first and retries E2B_API_KEY_FALLBACK only when
# E2B reports quota exhaustion, payment limits, or rate limits.
# E2B_API_KEYS can also provide a comma-separated ordered list for operators who
# need more than two keys; duplicate values are ignored while preserving order.
E2B_API_KEY=
E2B_API_KEY_FALLBACK=
E2B_API_KEYS=

# Optional E2B templates. If set, script workers use the runtime-specific
# template id when creating sandboxes. Leave deps-baked flags off unless that
# image already contains the worker dependencies, because they skip per-run
# pip/npm install.
# WORKEROS_E2B_PYTHON_TEMPLATE_ID=
# WORKEROS_E2B_NODE_TEMPLATE_ID=
# WORKEROS_E2B_DEFAULT_TEMPLATE_ID=
# WORKEROS_E2B_PYTHON_DEPS_BAKED=0
# WORKEROS_E2B_NODE_DEPS_BAKED=0

# Sandbox egress policy. Default (unset): allow all public egress, block only the
# private/internal ranges (right for single-tenant / self-host — you run your own
# workers). Set to 1 for MULTI-TENANT hosting of UNTRUSTED workers: sandboxes may
# then reach ONLY the platform hosts (LLM/API/Composio) + a worker's own declared
# allow_out, and nothing else (IPv4 allowlist). Add extra blocked CIDRs via
# WORKEROS_E2B_DENY_OUT (comma-separated).
# WORKEROS_E2B_RESTRICT_EGRESS=1
# WORKEROS_E2B_DENY_OUT=

FLOOM_DB=../../data/floom.db
FLOOM_ARTIFACTS_DIR=../../data/artifacts

# Worker + context bundle locations.
# These defaults live INSIDE this repo, which makes the git "workspace" used for
# version history the engine's own source checkout. The engine refuses to version
# into its own checkout (so it never pollutes/pushes this repo) — which means
# worker/context versioning is OFF with these defaults.
# To ENABLE version history + rollback, point BOTH at a directory OUTSIDE this
# repo that share a parent (that parent becomes the local workspace git repo):
#   FLOOM_WORKERS_DIR=~/.workeros/workers
#   FLOOM_CONTEXTS_DIR=~/.workeros/contexts
FLOOM_WORKERS_DIR=../../workers
FLOOM_CONTEXTS_DIR=../../contexts

# Optional: additional legitimate worker-source roots (colon-separated), beyond
# FLOOM_WORKERS_DIR. A worker whose stored bundle_path is an absolute path under
# one of these roots is allowed to resolve there (the dir must exist). Used in
# hosted deployments where seeded/example worker bundles live under a separate
# tree (e.g. /opt/floom/var/workers) than the deployed engine/workers.
# Unset = single-root behaviour (default). The path-traversal guard is never
# weakened: only paths under FLOOM_WORKERS_DIR or these explicit roots resolve.
# FLOOM_EXTRA_WORKERS_DIRS=/opt/floom/var/workers

# Git-backed workspace — optional remote to push version history to.
# Supports any git remote: GitHub, GitLab, Bitbucket, self-hosted.
# Format: https://{token}@github.com/{owner}/{repo}.git
# Pushes only to THIS remote, never to the engine's own repo. Leave unset to keep
# history local only.
WORKEROS_GIT_REMOTE=

# Where /runs/clear writes its mandatory pre-wipe DB snapshot.
# Defaults to /root/backups/manual when unset.
WORKEROS_PRECLEAR_BACKUP_DIR=/root/backups/manual

# Composio OAuth integration (required for Connections feature)
# Get key from app.composio.dev -> Settings -> API Keys
COMPOSIO_API_KEY=ak_...

# Composio trigger webhook verification.
# /composio-events returns 503 when this is missing.
COMPOSIO_WEBHOOK_SIGNING_KEY=

# Public base URL of the web frontend. Used for OAuth callback redirects
# (e.g. WORKERS_FRONTEND_URL/connections/callback), short links, and email links.
# Defaults to http://localhost:3000 in code; set to your real domain in production.
WORKERS_FRONTEND_URL=http://localhost:3000

# --- Run-notification emails (optional) -------------------------------------
# Worker run-finished emails are sent via Resend. Leave RESEND_API_KEY unset to
# disable email notifications entirely (the feature fails closed).
RESEND_API_KEY=
# From address for notification emails (must be a domain you've verified in Resend).
NOTIFY_FROM_EMAIL=notifications@example.com
# Branding shown in the notification email (all optional):
#   WORKEROS_BRAND_NAME    — brand name in the title/footer (default: Floom)
#   WORKEROS_EMAIL_LOGO_URL — absolute https logo URL; falls back to the brand
#                             name as text when unset (Gmail strips data URIs)
#   WORKEROS_SUPPORT_EMAIL  — optional contact shown in the footer; omitted if unset
WORKEROS_BRAND_NAME=
WORKEROS_EMAIL_LOGO_URL=
WORKEROS_SUPPORT_EMAIL=

# Webhook URL token = HMAC(per-worker rotatable secret, worker_id). Rotating a
# worker's webhook secret (POST /workers/{id}/webhook-secret/rotate) changes the
# token, so a leaked webhook URL is revoked. Default = HARD CUTOVER: switching to
# this scheme changes ALL existing webhook URLs; externally registered URLs must
# be re-copied from the UI. Set this to 1 to ALSO accept the pre-2026-06-02
# FLOOM_SECRET-derived token during a migration grace window (default OFF /
# secure). Leave unset in any deploy where you have already re-registered URLs.
WORKEROS_WEBHOOK_LEGACY_TOKEN_GRACE=

# SSRF deny-list escape hatch for MCP server URLs (default OFF / secure).
# By default, MCP HTTP/SSE connection URLs that point to internal, loopback,
# link-local (incl. cloud metadata 169.254.169.254), or RFC1918 private
# addresses are rejected at registration AND at dial time. Self-hosters who
# legitimately run a local MCP server (e.g. http://localhost:8011) can set this
# to 1 to bypass the deny-list. Leave unset/empty in any shared/hosted deploy.
WORKEROS_ALLOW_PRIVATE_MCP_URLS=

# MCP serve surface controls (#833/#838/#840, default OFF / secure).
# WORKEROS_MCP_ENABLED_TOOLS — optional comma-separated allow-list; when set,
# only the named default tools are served by /mcp-tools/serve (tools/list and
# tools/call). Example: workers.list,workers.run,runs.get,runs.list
# WORKEROS_MCP_ENABLE_DESTRUCTIVE — set to 1 to expose connections.add_mcp and
# workers.reload over MCP (admin-only even then). Leave unset in any
# shared/hosted deploy.
WORKEROS_MCP_ENABLED_TOOLS=
WORKEROS_MCP_ENABLE_DESTRUCTIVE=

# Slack integration — required for Emily in Slack and magic sign-in links.
# Get from api.slack.com -> Your Apps -> OAuth & Permissions.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Legacy single-user Slack mode (default OFF = 0). When OFF, every Slack DM
# sender must link their identity via the claim-link flow before Emily runs for
# them. Set to 1 ONLY for backward-compat single-user installs that pre-date the
# per-user binding system. New installs should leave this unset.
SLACK_LEGACY_SINGLE_USER=

# Magic sign-in link HMAC key — dedicated secret for signing /auth/magic-link tokens.
# Falls back to FLOOM_SECRET. When both are unset, magic-link ISSUANCE is refused
# (#917) — already-issued links validate against a per-process ephemeral key only.
WORKEROS_MAGIC_LINK_SECRET=
# Current behavior: when neither WORKEROS_MAGIC_LINK_SECRET nor FLOOM_SECRET is
# configured, magic-link issuance and validation fail closed.

# Upload download-URL signing key — signs /uploads/{id}?download_token=... tokens.
# Falls back to FLOOM_SECRET, then a per-process ephemeral key (#930): tokens
# can't be forged, but they stop validating after a restart until this is set.
WORKEROS_UPLOAD_URL_SIGNING_SECRET=
# Current behavior: when neither WORKEROS_UPLOAD_URL_SIGNING_SECRET nor
# FLOOM_SECRET is configured, upload download-token mint/verify fails closed.

# Upload/blob size limit. Default is 500 MiB so run inputs can accept common
# media files such as .mp4/.mov clips. Lower this for small self-hosted disks.
WORKEROS_UPLOAD_MAX_BYTES=

# Brain/context total pack limit. Default remains 50 MiB; raise this when using
# contexts as a media-heavy library. Request-body guard uses
# WORKEROS_CONTEXT_UPLOAD_MAX_BYTES separately.
WORKEROS_CONTEXT_MAX_BYTES=

# Signed public drop links (/drop/public/{id}/uploads). Falls back to
# FLOOM_SECRET; set a dedicated stable value for hosted/public deployments.
WORKEROS_DROP_LINK_SECRET=
# Public drop links are intentionally reusable for shared drop pages, but bounded
# to prevent a leaked link from queueing unlimited owner-charged runs.
WORKEROS_DROP_UPLOADS_PER_TOKEN_HOUR=25
# If a drop token omits max_size_mb, this smaller public-path cap applies before
# the global WORKEROS_UPLOAD_MAX_BYTES cap.
WORKEROS_DROP_DEFAULT_MAX_SIZE_MB=50

# LLM-heavy worker scheduling (#1448). Workers that declare `llm_intensive: true`
# consume this deployment-wide budget before dispatch, so judge-heavy runs queue
# instead of stacking into shared provider quota/rate limits. Leave unset to use
# the normal run concurrency cap.
WORKEROS_MAX_CONCURRENT_LLM_RUNS=

# Process role split (#1531). Default `all` preserves single-process OSS mode.
# Hosted/high-throughput deployments should run separate services against the
# same DB:
#   web    -> HTTP/API only; creates queued runs but never executes them
#   worker -> queue drain + scheduler + run reaper + E2B execution
#   all    -> both roles in one process (local/default)
WORKEROS_ROLE=all
# Run executor concurrency. Default in code is 6; raise only after measuring E2B
# quota, DB latency, and worker-service CPU/GIL contention.
WORKEROS_MAX_CONCURRENT_RUNS=

# Run hot-path caches (#1532). These avoid re-loading worker recipe metadata and
# re-resolving/decrypting secrets for every dispatch. Same-process mutations
# invalidate immediately; the TTL bounds staleness across split web/worker
# processes. Set either to 0 to disable.
WORKEROS_RUN_RECIPE_CACHE_TTL_SECONDS=10
WORKEROS_RUN_SECRET_CACHE_TTL_SECONDS=10

# Async run-log flushing (#1533). Default is off for strict local read-after-write
# semantics. In worker services, set to 1 to queue log writes and flush them in
# batches, reducing per-log-line DB contention during noisy runs.
WORKEROS_ASYNC_LOG_FLUSH=
WORKEROS_LOG_FLUSH_BATCH_SIZE=100
WORKEROS_LOG_FLUSH_INTERVAL_SECONDS=0.25

# Optional managed LLM gateway (#1448). When set, E2B sandboxes receive
# OPENAI_BASE_URL/OPENAI_API_KEY pointing at the gateway so litellm/openai calls
# use pooled provider quota and shared 429 backoff. Unset = direct provider calls.
WORKEROS_LLM_GATEWAY_URL=
WORKEROS_LLM_GATEWAY_KEY=

# Approval public-share link signing key — signs the per-approval HMAC token in
# /approvals/review?id=...&token=... and the /approvals/public/* reviewer surface.
# Falls back to FLOOM_SECRET (OSS single-tenant default). When NEITHER is set, the
# owner's GET /approvals list/detail still works but omits the optional public
# share link, and minting a NEW share link fail-closes (503) so no unsigned/
# forgeable link is ever emitted.
# Multi-tenant hosts should set this dedicated var for approval share links
# instead of sharing the deployment root secret.
WORKEROS_APPROVAL_SIGNING_SECRET=

# Role granted to x-floom-secret shared-secret requests (#933). Default: admin
# (backwards compat — treat FLOOM_SECRET as a root credential and rotate it
# accordingly). Set to "member" to demote the shared secret.
WORKEROS_SHARED_SECRET_ROLE=

# Maximum API-token lifetime in days for PATs and CLI device tokens (#924/#949).
# Unset = 90. Tokens created without an explicit expiry get this TTL; requested
# expiries beyond it are rejected. 0 disables the cap (legacy forever-tokens).
WORKEROS_PAT_MAX_TTL_DAYS=

# WhatsApp integration (Meta WhatsApp Business Cloud API) — makes Emily reachable
# on WhatsApp, mirroring the Slack integration. The /whatsapp/webhook endpoints
# are inert and fail closed when these are absent, so leaving them unset is safe.
# Set all four below to wire Emily to a real number (see
# docs/integrations/whatsapp-assessment.md for the Meta setup walkthrough).
#
# Phone Number ID (numeric) — Meta App -> WhatsApp -> API Setup -> Phone number ID
WHATSAPP_PHONE_ID=
# Permanent System User access token (Bearer) — Meta Business Settings ->
# System Users -> Generate Token (whatsapp_business_messaging + management, no expiry)
WHATSAPP_TOKEN=
# App Secret — Meta App -> Settings -> Basic -> App Secret (used for X-Hub-Signature-256 HMAC)
WHATSAPP_APP_SECRET=
# Webhook verify token — a random string you invent when registering the callback URL
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Graph API version (optional, defaults to v23.0)
WHATSAPP_GRAPH_VERSION=v23.0
