# Web app configuration. `scripts/setup.{sh,ps1}` copies this to apps/web/.env.
#
# Point the web app at your backend. For local dev this is the local API
# (apps/api on http://localhost:8000). Without it, the web app falls back to the
# default remote API, so a fresh local install might show the wrong sign-in
# screen instead of "Create your workspace".
# Self-hosting elsewhere? Set both to your deployed API's URL.
FLOOM_API_BASE=http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# WhatsApp bot number (digits only, no + prefix, e.g. 16503999709).
# Set this to the number your deployment should advertise.
# When unset, the WhatsApp channel card renders a "not configured" message.
# NEXT_PUBLIC_WA_BOT_NUMBER=

# PostHog product analytics (client). When NEXT_PUBLIC_POSTHOG_KEY is unset,
# all client analytics + session replay are a no-op (safe for local/dev and
# self-hosted instances that do not run analytics).
#
# The key is never committed. With it unset, the build ships only inert wiring
# -- no key, no destination -- so nothing is collected. To enable analytics,
# set NEXT_PUBLIC_POSTHOG_KEY to your own PostHog project key; events route to
# your project. Host defaults to https://us.i.posthog.com (the ingest host)
# when unset.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
