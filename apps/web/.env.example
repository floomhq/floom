# PostHog product analytics. Leave NEXT_PUBLIC_POSTHOG_KEY empty for local
# development without analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Shared PostHog project separator. Use workeros-oss for the engine app and
# workeros-cloud for the cloud deployment.
NEXT_PUBLIC_POSTHOG_PRODUCT=workeros-oss

