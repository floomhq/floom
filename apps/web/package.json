{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run lint:emdash && npm run lint:borders",
    "lint:emdash": "bash -c 'hits=$(grep -rnP \"\\x{2014}\" --include=\"*.tsx\" --include=\"*.ts\" app/ components/ lib/ 2>/dev/null | grep -vP \"^\\S+:\\d+:\\s*(//|\\*|/\\*)\" | grep -vP \"\\{\\s*/\\*\" | grep -vP \"\\*/\\s*\\}\" | grep -vP \"<span[^>]*>—<\\\\/span>\" | grep -vP \"return \\\"—\\\"|\\?\\? \\\"—\\\"|\\|\\| \\\"—\\\"\" | grep -vP \"// \" | grep -v \"em-dash-ok\" | grep -v \"Binary\"); if [ -n \"$hits\" ]; then echo \"Em dash (U+2014) found in copy strings. Replace with comma/colon/semicolon/parens. Add em-dash-ok comment to opt out.\"; echo \"$hits\"; exit 1; fi'",
    "lint:borders": "node scripts/lint-borders.mjs --fail",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@types/jszip": "^3.4.0",
    "@types/papaparse": "^5.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "8.0.4",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/diff": "^8.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "25.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
