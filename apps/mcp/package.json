{
  "name": "@floomhq/floom",
  "version": "5.1.11",
  "description": "Hosted Floom Cloud CLI + MCP installer, with self-hosted support available via explicit local mode.",
  "type": "module",
  "bin": {
    "floom-mcp": "bin/floom-mcp",
    "workeros-mcp": "bin/workeros-mcp",
    "workeros": "dist/cli.js",
    "floom": "dist/cli.js"
  },
  "files": [
    "assets/",
    "bin/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "open": "^11.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
