# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# runtime: per-workspace git repos created by the API at runtime
/var/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
.venv/
__pycache__/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workplan + codex artifacts
WORKPLAN-*.md
CODEX_BRIEF.md
.phase-state.json
.codex-*.md
.codex-*.log
.gstack/
.env.test
tests/e2e/.auth/
