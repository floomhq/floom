# Dependencies
node_modules/
__pycache__/
*.pyc
venv/
.venv/
.env
.env.*
!.env.example
!apps/api/.env.example

# Workspace configuration (user-editable, not committed)
workspace.md
workspace.base.md

# Data
# Glob covers the SQLite WAL/SHM sidecars (floom.db-wal, floom.db-shm) too — the
# -wal can hold un-checkpointed sessions/secrets, so it must never be committed.
data/floom.db*
data/artifacts/*
!data/artifacts/.gitkeep
data/blobs/
data/run-bundles/
data/*.log
# The API runs from apps/api/, so its local SQLite DB + run bundles live at
# apps/api/data/ — the repo-root data/ rules above don't reach it. This dir
# holds OAuth tokens, secrets, sessions and PATs; never commit it.
apps/api/data/
contexts/*
!contexts/.gitkeep
# worker-author-style is a platform-managed context (seeded at install)
!contexts/worker-author-style
!contexts/worker-author-style/**

# Audit reports (may contain leaked secret values in evidence; keep local only)
docs/launch-readiness/agent-runs/
# Local review/feedback drops are iteration evidence, not OSS source.
feedback/

# Build
.next/
apps/web/*.log
dist/
build/

# IDE
.vscode/
.idea/
WORKPLAN-*.md
CODEX_BRIEF.md
.codex-last-message.md
.codex-stdout.log
.codex-logs/

# Secrets
.deploy-secret
# #1436 defense-in-depth: never commit loose secret-bearing dumps even when they
# land in the tree with a non-.env name (the audit found a *-env-setup.txt with
# live prod secrets that the .env rules above did not catch).
*env-setup*.txt
*env-backup*
*_env_backup*
*.jwt
# Local credential-hygiene audit/runbook (names which files hold secrets).
/SECURITY-*credential*.md

# OS
.DS_Store
.vercel
.gstack/

# api modularization scratch artifacts
BASELINE_api_tests.txt
P*_full.txt
